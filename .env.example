# Copy to .env and fill in. Never commit .env.

# Local UAT: lets the web app write as the fixed "Demo Workspace" user and enables MCP writes.
# Keep false (or unset) on any public deployment.
DEMO_MODE=true

# SQLite file shared by the web app and the MCP server
LECTA_DB_PATH=./data/lecta.db

# Bearer key an MCP client must send to call create_exhibition_draft. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LECTA_MCP_WRITE_KEY=

# MCP server
MCP_PORT=3333
LECTA_MCP_URL=http://127.0.0.1:3333/mcp
# Links returned by MCP tools point here
LECTA_APP_URL=http://localhost:3000

# Optional — only for `npm run agent:demo` (real LLM tool-calling loop). Not needed for anything else.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
