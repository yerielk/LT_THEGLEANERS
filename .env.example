# Copy to .env and fill in. Never commit .env.

# PostgreSQL 17. For a local install, create the lecta role and database first.
# This matches the fallback in src/lib/db.ts and docker-compose.yml.
DATABASE_URL=postgres://lecta:lecta@127.0.0.1:5432/lecta

# Local sign-in and write settings.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
DEMO_MODE=true

# Kakao login (only needed for Kakao sign-in; not for anonymous local browsing).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REQUEST_EMAIL=false

# Optional MCP and agent settings.
LECTA_MCP_KEY=
LECTA_ADMIN_USER_IDS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional local Ollama embedding endpoint for meaning-based curation recommendations.
# When unset or unavailable, recommendations still use direct inclusion and keyword matches.
# LECTA_EMBEDDING_URL=http://127.0.0.1:11434
# LECTA_EMBEDDING_MODEL=nomic-embed-text
